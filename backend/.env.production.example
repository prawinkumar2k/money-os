# Production environment template. Copy to .env on the production host (or, better, set these
# as real secrets in your hosting provider's secret manager / environment-variable dashboard —
# never commit a real .env, production or otherwise). Every value below is a placeholder.

PORT=4000
NODE_ENV=production

# A managed, replicated MongoDB is strongly recommended over a self-hosted single instance for
# production (automatic backups, failover). MongoDB Atlas free/shared tier is enough to start:
# https://www.mongodb.com/atlas — create a cluster, a database user, and allow-list this host's
# outbound IP (or 0.0.0.0/0 only if your host has no static IP, e.g. most PaaS — prefer a static
# IP / VPC peering where your host supports it).
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/money-os?retryWrites=true&w=majority

# Generate real, unique values — never reuse the dev secrets. E.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<generate-a-long-random-secret-min-32-chars>
JWT_REFRESH_SECRET=<generate-a-different-long-random-secret-min-32-chars>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# 32-byte hex key, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Currently unused by any code path (no live provider integration stores encrypted credentials
# yet — see FinancialConnection.encryptedCredentials), but still required at startup; keep it
# real and secret now so it's already correct the day a real provider is wired in.
ENCRYPTION_KEY=<generate-a-real-32-byte-hex-key>

# Comma-separated, no spaces needed (trimmed either way). Must include:
#  - your production web frontend's real HTTPS origin (exact scheme+host+port, no trailing slash)
#  - https://localhost and capacitor://localhost — what the Android/iOS native app's WebView
#    actually sends as Origin; needed for the mobile app to reach this API at all, regardless of
#    what domain the API itself is hosted on
CORS_ORIGIN=https://<your-production-frontend-domain>,https://localhost,capacitor://localhost

# Real Account Aggregator / open-banking provider credentials go here once one is chosen.
# Left unset — only the MockProvider (dev-only, clearly labeled as mock everywhere in the UI) is
# active without these.
# PROVIDER_CLIENT_ID=
# PROVIDER_CLIENT_SECRET=
# PROVIDER_REDIRECT_URI=
