# Production environment template for the self-hosted setup (see readme.md's "Self-hosted — the
# actual chosen path" section). This project deliberately does not use a cloud database or PaaS —
# copy this to a real .env only on your own machine/server, or better, pass these as real secrets
# directly on the `docker compose -f docker-compose.prod.yml up` command line. Never commit a
# real .env, production or otherwise. Every value below is a placeholder.

PORT=4000
NODE_ENV=production

# When running via docker-compose.prod.yml, this is set automatically to the self-hosted `mongo`
# container (mongodb://mongo:27017/money-os) — you do not need to set MONGODB_URI yourself in
# that path. This line only matters if you're running the backend outside that compose file.
MONGODB_URI=mongodb://127.0.0.1:27017/money-os

# Generate real, unique values — never reuse the dev secrets. E.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<generate-a-long-random-secret-min-32-chars>
JWT_REFRESH_SECRET=<generate-a-different-long-random-secret-min-32-chars>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# 32-byte hex key, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Currently unused by any code path (no live provider integration stores encrypted credentials
# yet — see FinancialConnection.encryptedCredentials), but still required at startup; keep it
# real and secret now so it's already correct the day a real provider is wired in.
ENCRYPTION_KEY=<generate-a-real-32-byte-hex-key>

# Comma-separated, no spaces needed (trimmed either way). Must include:
#  - your machine's real Tailscale HTTPS hostname (from `bash scripts/get-tailscale-cert.sh`),
#    e.g. https://your-machine.your-tailnet.ts.net
#  - https://localhost and capacitor://localhost — what the Android/iOS native app's WebView
#    actually sends as Origin; needed for the mobile app to reach this API at all
CORS_ORIGIN=https://<your-machine>.<your-tailnet>.ts.net,https://localhost,capacitor://localhost

# Real Account Aggregator / open-banking provider credentials go here once one is chosen.
# Left unset — only the MockProvider (dev-only, clearly labeled as mock everywhere in the UI) is
# active without these.
# PROVIDER_CLIENT_ID=
# PROVIDER_CLIENT_SECRET=
# PROVIDER_REDIRECT_URI=
