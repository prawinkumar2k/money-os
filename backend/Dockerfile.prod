# Production image: compiles TypeScript in a builder stage, then runs the compiled output with
# only production dependencies installed — no ts-node/tsx watch mode, no devDependencies shipped.
# The existing Dockerfile (npm run dev) stays as-is for local docker-compose development.

FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=builder /app/dist ./dist

EXPOSE 4000
CMD ["node", "dist/index.js"]
