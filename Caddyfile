{$TS_HOSTNAME} {
	# Real HTTPS via a cert generated once by `tailscale cert` (see readme.md), not automatic
	# Let's Encrypt — a private Tailscale hostname has no public DNS for Let's Encrypt to verify.
	tls /certs/tailscale.crt /certs/tailscale.key

	handle /api/* {
		reverse_proxy backend:4000
	}

	handle {
		reverse_proxy frontend:80
	}
}
